generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app", "pii", "limits"]
}

enum UserStatus {
  ACTIVE
  ARCHIVED

  @@schema("app")
}

model User {
  id        String        @id @default(uuid()) @db.Uuid
  status    UserStatus    @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  identity  Identity?
  wallet    Wallet?
  usage     LimitUsage?
  sent      Transaction[] @relation("SentTransfers")
  received  Transaction[] @relation("ReceivedTransfers")

  @@map("users")
  @@schema("app")
}

model Identity {
  userId      String @id @map("user_id") @db.Uuid
  mobile      String @unique
  displayName String @map("display_name")

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("piis")
  @@schema("pii")
}

model Wallet {
  userId    String   @id @map("user_id") @db.Uuid
  balance   Decimal  @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
  @@schema("app")
}

enum TransactionStatus {
  INITIAL
  COMPLETED
  FAILED

  @@schema("app")
}

model Transaction {
  id          String            @id @default(uuid()) @db.Uuid
  senderId    String            @map("sender_id") @db.Uuid
  recipientId String            @map("recipient_id") @db.Uuid
  amount      Decimal           @db.Decimal(14, 2)
  status      TransactionStatus @default(INITIAL)
  note        String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  sender     User              @relation("SentTransfers", fields: [senderId], references: [id])
  recipient  User              @relation("ReceivedTransfers", fields: [recipientId], references: [id])

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@map("transactions")
  @@schema("app")
}

model LimitPolicy {
  code       String  @id
  dailyCap   Decimal @map("daily_cap") @db.Decimal(14, 2)
  monthlyCap Decimal @map("monthly_cap") @db.Decimal(14, 2)

  @@map("limit_policies")
  @@schema("limits")
}

model LimitUsage {
  userId             String   @id @map("user_id") @db.Uuid
  dailyUsed          Decimal  @default(0) @map("daily_used") @db.Decimal(14, 2)
  monthlyUsed        Decimal  @default(0) @map("monthly_used") @db.Decimal(14, 2)
  dailyPeriodStart   DateTime @map("daily_period_start") @db.Timestamptz(3)
  monthlyPeriodStart DateTime @map("monthly_period_start") @db.Timestamptz(3)

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_limit_usage")
  @@schema("limits")
}


